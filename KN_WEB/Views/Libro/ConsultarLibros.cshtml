@model List<KN_WEB.EF.tLibro>

<div class="page-header">
    <div>
        <h1 class="page-title">Libros</h1>
        <p class="page-subtitle">Consulta y administra el catálogo de libros</p>
    </div>
    <a href="@Url.Action("RegistrarLibros", "Libro")" class="btn-dark-custom text-decoration-none">
        <span class="icon-wrap"><i class="bi bi-plus"></i></span>
        <span>Agregar libro</span>
    </a>
</div>

<div class="table-card-custom">
    <div class="table-responsive p-3">
        <table id="tablaLibros" class="table-custom w-100">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Título</th>
                    <th>Autor</th>
                    <th class="text-center">Portada</th>
                    <th>Género</th>
                    <th class="text-end">Precio</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in Model)
                {
                    <tr>
                        <td>@libro.IdLibro</td>
                        <td>@libro.Titulo</td>
                        <td>@libro.Autor</td>
                        <td class="text-center"><img src="@libro.Portada" alt="Portada" /></td>
                        <td>@libro.Genero</td>
                        <td class="text-end" data-order="@libro.Precio">@libro.Precio.ToString("N2")</td>
                        <td class="text-center">
                            <span class="badge-table @(libro.Estado ? "success" : "failed")">@(libro.Estado ? "Activo" : "Inactivo")</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/consultarLibros.js"></script>
}
