@model KN_WEB.Models.UsuarioModel

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="login-wrapper">
    <div class="login-bg-shape login-bg-shape-1"></div>
    <div class="login-bg-shape login-bg-shape-2"></div>

    <div class="login-card">

        <a href="index.html" class="login-brand text-decoration-none">
            <i class="bi bi-asterisk"></i>
            <span>Proyecto Web</span>
        </a>

        <form method="post" asp-action="Register" asp-controller="Home" id="loginForm" class="needs-validation" novalidate>

            <div class="login-form-group">
                <label class="login-form-label">Identificación</label>
                <div class="login-input-group">
                    <i class="bi bi-person-badge input-icon"></i>
                    @Html.TextBoxFor(m => m.Identificacion, new { @class = "login-input" })
                </div>
            </div>

            <div class="login-form-group">
                <label class="login-form-label">Nombre Completo</label>
                <div class="login-input-group">
                    <i class="bi bi-person input-icon"></i>
                    @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "login-input" })
                </div>
            </div>

            <div class="login-form-group">
                <label class="login-form-label">Correo Electrónico</label>
                <div class="login-input-group">
                    <i class="bi bi-envelope input-icon"></i>
                    @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "login-input" })
                </div>
            </div>

            <div class="login-form-group">
                <label class="login-form-label">Contraseña</label>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    @Html.TextBoxFor(m => m.Contrasenna, new { @class = "login-input login-input-password", @type = "password" })

                    <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-login" id="btn-submit">
                <span>Procesar</span>
            </button>

        </form>

        <div class="login-divider"></div>

        <p class="login-footer-text">
            <a href="#" id="link-register">ya tiene una cuenta?</a>
        </p>

    </div>
</div>