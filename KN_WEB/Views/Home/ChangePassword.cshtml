@model KN_WEB.Models.UsuarioModel

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="login-wrapper">
    <div class="login-bg-shape login-bg-shape-1"></div>
    <div class="login-bg-shape login-bg-shape-2"></div>

    <div class="login-card">

        <a href="@Url.Action("Login","Home")" class="login-brand text-decoration-none">
            <i class="bi bi-asterisk"></i>
            <span>Proyecto Web</span>
        </a>

        <form method="post" asp-action="ChangePassword" asp-controller="Home" id="changePasswordForm" class="needs-validation" novalidate>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Message</div>
            }

            <div class="login-form-group">
                <label class="login-form-label">Contraseña Nueva</label>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    @Html.TextBoxFor(m => m.Contrasenna, new { @class = "login-input login-input-password", @type = "password" })

                    <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <div class="login-form-group">
                <label class="login-form-label">Confirmar Contraseña Nueva</label>
                <div class="login-input-group">
                    <i class="bi bi-shield-lock input-icon"></i>
                    @Html.TextBoxFor(m => m.ConfirmarContrasenna, new { @class = "login-input login-input-password", @type = "password" })

                    <button type="button" class="password-toggle-btn" id="toggle-password" aria-label="Show password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-login" id="btn-submit">
                <span>Procesar</span>
            </button>

        </form>

    </div>
</div>

@section Scripts {
    <script src="~/assets/js/changePassword.js"></script>
}
